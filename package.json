{
  "name": "andrewix-statusline",
  "version": "1.0.0",
  "description": "Styled statusline footer for Command Code, matching Oh My Posh theme",
  "type": "module",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format . --write",
    "fix": "biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "conf": "^15.1.0",
    "dayjs": "^1.11.23",
    "picocolors": "^1.1.1",
    "remeda": "^2.50.0"
  }
}
